# Deployment configuration — both are set automatically in
# .github/workflows/pages.yml for the production build.

# Sub-path the site is served from (GitHub Pages project site).
# Leave empty when serving from a custom domain root.
NEXT_PUBLIC_BASE_PATH=/All-In-One-Holiday

# Absolute site origin (+ base path) for canonical, sitemap,
# JSON-LD and Open Graph URLs. Without it siteUrl() falls back
# to https://ngayleviet.vn — a placeholder, not a real deployment.
NEXT_PUBLIC_SITE_URL=https://jasontm17.github.io/All-In-One-Holiday
